{
  "schemaVersion": 1,
  "id": "drmd",
  "version": "${version}",
  "name": "DRMD 6DOF",
  "description": "Descent-like 6DoF Minecraft: inertial flight, arsenal, world layers. Far view via Distant Horizons (suggested) — no built-in voxel LLOD.",
  "authors": ["Terminal", "DRMD Team"],
  "contact": {
    "homepage": "https://github.com/terminaldetector/ReforkDescnt",
    "sources": "https://github.com/terminaldetector/ReforkDescnt",
    "issues": "https://github.com/terminaldetector/ReforkDescnt/issues"
  },
  "license": "MIT",
  "icon": "assets/drmd/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.terminaldetector.drmd.DescentMod"],
    "client": ["com.terminaldetector.drmd.client.DescentClient"]
  },
  "mixins": ["drmd.mixins.json"],
  "accessWidener": "drmd.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "distanthorizons": "*",
    "sodium": "*",
    "immersive_portals": "*",
    "imm_ptl_core": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://github.com/terminaldetector/ReforkDescnt"
      }
    }
  }
}
