{
  "schemaVersion": 1,
  "id": "drmd",
  "version": "${version}",
  "name": "DRMD 6DOF",
  "description": "Descent-Inspired Resource Management Dynamics — full 6DOF combat flight, energy, shields, weapons, AI, and Weapon Workshop. Minecraft port of the Garry's Mod DRMD 6DOF addon.",
  "authors": ["Terminal", "DRMD Team"],
  "contact": {
    "sources": "https://github.com/terminaldetector/ReforkDescnt"
  },
  "license": "MIT",
  "icon": "assets/drmd/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.terminaldetector.drmd.DescentMod"],
    "client": ["com.terminaldetector.drmd.client.DescentClient"]
  },
  "mixins": ["drmd.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
