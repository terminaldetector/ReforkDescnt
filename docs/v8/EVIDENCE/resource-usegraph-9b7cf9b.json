          "line": 28,
          "text": "/** Chunk-batched damage/organic geometry. No per-frame BER or live block-entity reads. */"
        },
        {
          "line": 29,
          "text": "public final class HybridTerrainModel extends ForwardingBakedModel {"
        },
        {
          "line": 30,
          "text": "    private static final Identifier MODEL = Identifier.of(\"drmd\", \"block/carved\");"
        },
        {
          "line": 31,
          "text": "    private static final Direction[] DIRECTIONS={Direction.DOWN,Direction.UP,Direction.NORTH,Direction.SOUTH,Direction.WEST,Direction.EAST};"
        },
        {
          "line": 32,
          "text": "    private static final int[] QUAD={0,1,2,3}, TRIANGLE_A={0,1,2,2}, TRIANGLE_B={0,2,3,3};"
        },
        {
          "line": 33,
          "text": "    private HybridTerrainModel(BakedModel delegate) { super(delegate); }"
        },
        {
          "line": 34,
          "text": ""
        },
        {
          "line": 35,
          "text": "    public static void register() {"
        },
        {
          "line": 36,
          "text": "        ModelLoadingPlugin.register(plugin -> plugin.modifyModelAfterBake().register((model,context) ->"
        },
        {
          "line": 37,
          "text": "            (MODEL.equals(context.resourceId()) || context.resourceId()!=null && context.resourceId().getNamespace().equals(\"drmd\") && context.resourceId().getPath().startsWith(\"block/organic_\")"
        },
        {
          "line": 38,
          "text": "                || context.topLevelId()!=null && !context.topLevelId().getVariant().equals(\"inventory\"))"
        },
        {
          "line": 39,
          "text": "                && model!=null && !(model instanceof HybridTerrainModel) ? new HybridTerrainModel(model) : model));"
        },
        {
          "line": 40,
          "text": "    }"
        },
        {
          "line": 41,
          "text": "    @Override public boolean isVanillaAdapter() { return false; }"
        },
        {
          "line": 42,
          "text": "    @Override public boolean isBuiltin() { return false; }"
        }
      ]
    },
